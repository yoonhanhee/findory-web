<!DOCTYPE html>
<html lang="ko">

<head>

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Findory | 기록하기</title>

    <link rel="stylesheet" href="/css/common.css">
    <link rel="stylesheet" href="/css/write.css">

</head>

<body>

<header class="header">

    <div class="logo">

        <a href="/home">
            <img src="/images/logo.png" alt="Findory">
        </a>

    </div>

    <nav class="nav">

        <a href="/home">홈</a>
        <a href="/write" class="active">기록</a>
        <a href="/search">검색</a>
        <a href="/library">서재</a>
        <a href="/logout">로그아웃</a>

    </nav>

</header>

<main class="write-page">

    <section class="write-title">

        <p class="sub-title">Findory Write</p>

        <h1>
            <%= mode === "edit" ? "독서 기록을 수정해보세요." : "오늘의 독서 경험을 기록해보세요." %>
        </h1>

        <p>
            제목만 기억하는 기록이 아닌, 감정과 상황까지 함께 저장하는 나만의 독서 기록입니다.
        </p>

    </section>

    <section class="write-box">

        <% if(message!=""){ %>

            <div class="message">

                <%= message %>

            </div>

        <% } %>

        <form
            method="post"
            enctype="multipart/form-data"
            action="<%= mode === 'edit' ? '/edit/' + index : '/write' %>">

            <section class="cover-section">

                <label for="cover" class="cover-upload" id="coverUpload">

                    <div class="cover-preview" id="coverPreview">

                        <% if(book && book.coverImage && book.coverImage !== "/images/default-book.png"){ %>

                            <img src="<%= book.coverImage %>" alt="책 표지 미리보기">

                        <% } else { %>

                            <strong class="book-placeholder">BOOK</strong>

                        <% } %>

                    </div>

                    <div class="cover-text">

                        <strong>책 표지를 추가해보세요</strong>

                        <p>클릭하거나 이미지를 드래그하여 업로드</p>

                        <em>선택하지 않으면 기본 BOOK 표지가 사용됩니다.</em>

                    </div>

                </label>

                <input
                    id="cover"
                    name="cover"
                    type="file"
                    accept="image/*"
                    class="cover-input">

                <p id="coverFileName" class="cover-file-name">
                    선택된 이미지 없음
                </p>

            </section>

            <div class="form-grid">

                <div class="form-item">

                    <label for="title">책 제목</label>

                    <input
                        id="title"
                        name="title"
                        type="text"
                        value="<%= book ? book.title : '' %>"
                        placeholder="예 : 달러구트 꿈 백화점">

                </div>

                <div class="form-item">

                    <label for="author">저자</label>

                    <input
                        id="author"
                        name="author"
                        type="text"
                        value="<%= book ? book.author : '' %>"
                        placeholder="예 : 이미예">

                </div>

            </div>

            <input type="hidden" id="genreInput" name="genre" value="<%= book ? book.genre : '' %>">
            <input type="hidden" id="emotionInput" name="emotion" value="<%= book ? book.emotion : '' %>">
            <input type="hidden" id="weatherInput" name="weather" value="<%= book ? book.weather : '' %>">
            <input type="hidden" id="timeInput" name="time" value="<%= book ? book.time : '' %>">
            <input type="hidden" id="starInput" name="star" value="<%= book ? book.star : '' %>">

            <section class="choice-section">

                <div class="section-header">

                    <div>

                        <h3>📚 장르</h3>

                        <p>여러 개 선택할 수 있습니다.</p>

                    </div>

                    <button
                        type="button"
                        class="toggle-btn"
                        data-target="genreGrid">

                        더보기

                    </button>

                </div>

                <div
                    id="genreGrid"
                    class="choice-grid collapsed">

                </div>

            </section>

            <section class="choice-section">

                <div class="section-header">

                    <div>

                        <h3>😊 감정</h3>

                        <p>여러 개 선택할 수 있습니다.</p>

                    </div>

                    <button
                        type="button"
                        class="toggle-btn"
                        data-target="emotionGrid">

                        더보기

                    </button>

                </div>

                <div
                    id="emotionGrid"
                    class="choice-grid collapsed">

                </div>

            </section>

            <section class="choice-section">

                <div class="section-header">

                    <div>

                        <h3>🌤 날씨</h3>

                        <p>하나만 선택합니다.</p>

                    </div>

                    <button
                        type="button"
                        class="toggle-btn"
                        data-target="weatherGrid">

                        더보기

                    </button>

                </div>

                <div
                    id="weatherGrid"
                    class="choice-grid collapsed">

                </div>

            </section>

            <section class="choice-section">

                <div class="section-header">

                    <div>

                        <h3>🕒 시간대</h3>

                        <p>하나만 선택합니다.</p>

                    </div>

                    <button
                        type="button"
                        class="toggle-btn"
                        data-target="timeGrid">

                        더보기

                    </button>

                </div>

                <div
                    id="timeGrid"
                    class="choice-grid collapsed">

                </div>

            </section>

            <section class="choice-section">

                <div class="section-header">

                    <div>

                        <h3>⭐ 별점</h3>

                        <p>작품에 대한 만족도를 선택해주세요.</p>

                    </div>

                </div>

                <div id="rating" class="rating"></div>

            </section>

            <section class="review-item">

                <label for="review">감상평</label>

                <textarea
                    id="review"
                    name="review"
                    placeholder="책을 읽으며 느낀 점을 자유롭게 기록해보세요."><%= book ? book.review : '' %></textarea>

            </section>

            <button
                class="save-btn"
                type="submit">

                <%= mode === "edit" ? "수정 저장하기" : "기록 저장하기" %>

            </button>

        </form>

    </section>

</main>

<div class="alert-modal" id="alertModal">

    <div class="alert-box">

        <h3>입력 확인</h3>

        <p id="alertMessage"></p>

        <button type="button" id="alertClose">
            확인
        </button>

    </div>

</div>

<script src="/js/write.js"></script>

</body>

</html>